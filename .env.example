# Synthetic bank only. Credentials belong in the local .env, never in commits.
LLM_API_KEY=
# Adopted model tiers; gpt-6 function calls require Responses.
LLM_MODEL=gpt-6.1-sol
LLM_MODEL_CHEAP=gpt-6-luna
LLM_MODEL_WEAK=gpt-5.4-mini
LLM_API=responses
LLM_REASONING_EFFORT=low
# Hard per-client limits; live/record require both positive budgets.
LLM_MAX_USD=15
LLM_MAX_CALLS=3000
# Conservative assumptions in USD per million tokens, not official billing prices.
LLM_ASSUMED_PRICE_IN=10
LLM_ASSUMED_PRICE_OUT=40
